load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "runner",
    srcs = [
        "concurrency.go",
        "handle_resource_request.go",
        "handle_tool_call.go",
        "impl.go",
        "request.go",
        "sysinfo_darwin.go",
        "sysinfo_linux.go",
        "sysinfo_other.go",
    ],
    importpath = "github.com/speakeasy-api/gram/functions/internal/runner",
    visibility = ["//functions:__subpackages__"],
    deps = [
        "//functions/internal/attr",
        "//functions/internal/auth",
        "//functions/internal/encryption",
        "//functions/internal/guardian",
        "//functions/internal/ipc",
        "//functions/internal/o11y",
        "//functions/internal/svc",
        "@org_golang_x_sync//semaphore",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "runner_test",
    srcs = [
        "bench_test.go",
        "concurrency_test.go",
        "handle_tool_call_test.go",
    ],
    embed = [":runner"],
    deps = [
        "//functions/internal/javascript",
        "@com_github_stretchr_testify//require",
        "@org_golang_x_sync//semaphore",
    ],
)
