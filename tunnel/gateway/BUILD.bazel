)

go_test(
    name = "gateway_test",
    srcs = [
        "gateway_test.go",
        "jwks_test.go",
        "reconciler_test.go",
    ],
    embed = [":gateway"],
    deps = [
        "//tunnel/jwks",
        "//tunnel/route",
        "//tunnel/wire",
        "@com_github_coder_websocket//:websocket",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_hashicorp_yamux//:yamux",
        "@com_github_stretchr_testify//require",
    ],
