{
  "permissions": {
    "allow": [
      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(kubectl apply --dry-run=client:*)",
      "Bash(kubectl explain:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(find:*)",
      "Bash(docker:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(go:*)",
      "Bash(ls:*)",
      "Bash(mise test:*)",
      "Bash(mise lint:*)",
      "Bash(mise build:*)",
      "Bash(mise gen:*)",
      "Read",
      "Edit(infra/**)",
      "Edit(client/**)",
      "Edit(server/**)",
      "WebFetch"
    ],
    "deny": ["Read(mise.local.toml)"]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/worktree-hooks/create.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/worktree-hooks/remove.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "preferredLineLength": 120,
  "notes": "Only use kubectl and terraform commands for validation/dry-run as defined in CLAUDE.md. Only run mise commands for local iteration (helm:up, helm:update, k8s:refresh). Do not automatically run commands that make real infrastructure changes without specific user request."
}
