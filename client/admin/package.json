{
  "name": "admin",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "aube run lint:format && aube run lint:no-barrels && aube run lint:oxlint && aube run type-check",
    "lint:oxlint": "oxlint --type-aware --ignore-pattern 'src/sdk/**'",
    "lint:fix": "oxlint --type-aware --fix --ignore-pattern 'src/sdk/**'",
    "lint:format": "aube exec oxfmt -- --check .",
    "lint:no-barrels": "! grep -rEn '^export \\*' src --include='*.ts' --include='*.tsx' --exclude-dir=sdk || (echo 'Barrel re-exports (export *) are not allowed. Re-export named symbols instead.' && exit 1)",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/charts": "^0.18.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "catalog:",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tr46": "^6.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.168.37",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/tr46": "^5.0.1",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "^20.11.2",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react-grab": "^0.2.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.0.0"
  }
}
