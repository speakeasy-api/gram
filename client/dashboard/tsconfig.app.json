{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2024",
    "useDefineForClassFields": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      "@gram/client": ["./src/sdk/src/index.ts"],
      "@gram/client/*": ["./src/sdk/src/*"]
    },

    /* Dead-code guards */
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Strict additions */
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", ".storybook/preview.tsx", ".storybook/providers.tsx"],
  // A developer's gitignored local files are theirs, and may reach outside this
  // package for code that does not typecheck under these settings.
  "exclude": ["src/**/*.local.tsx"]
}
