<clickhouse>
    <logger>
        <level>warning</level>
        <console>true</console>
        <!-- Docker already captures console output, so the file loggers only duplicate it.
             A transient write failure permanently poisons Poco's log file stream, after
             which every message throws and recurses through the async channel, pinning
             the container at 100% CPU until it is recreated. -->
        <log remove="remove"/>
        <errorlog remove="remove"/>
    </logger>
    <query_thread_log remove="remove"/>
    <query_log remove="remove"/>
    <text_log remove="remove"/>
    <trace_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <session_log remove="remove"/>
    <part_log remove="remove"/>
</clickhouse>