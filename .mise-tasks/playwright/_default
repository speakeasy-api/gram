#!/usr/bin/env bash

#MISE description="Run Playwright CLI, installing its browser on first use"
# Browser automation always targets the local dashboard, so wake a paused stack
# first -- otherwise the run screenshots the parker's "Resuming stack" page.
#MISE depends=["ensure-stack"]

set -e

stderr_file="$(mktemp)"
trap 'rm -f "$stderr_file"' EXIT

if playwright-cli "$@" 2>"$stderr_file"; then
  cat "$stderr_file" >&2
  exit 0
else
  status=$?
fi

cat "$stderr_file" >&2

# The repository config launches the system Google Chrome (channel "chrome") so
# it picks up Chrome's own auto-updates, rather than Playwright's pinned
# Chromium build, which lags behind upstream security fixes.
if ! grep -Eq "is not installed\. Run \`playwright-cli install-browser|Chromium distribution 'chrome' is not found" "$stderr_file"; then
  exit "$status"
fi

echo "Installing Google Chrome and system dependencies..." >&2
playwright-cli install-browser chrome --with-deps

rm -f "$stderr_file"
trap - EXIT
exec playwright-cli "$@"
