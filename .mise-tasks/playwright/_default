#!/usr/bin/env bash

#MISE description="Run Playwright CLI against the system Google Chrome"
# Browser automation always targets the local dashboard, so wake a paused stack
# first -- otherwise the run screenshots the parker's "Resuming stack" page.
#MISE depends=["ensure-stack"]

set -e

stderr_file="$(mktemp)"
trap 'rm -f "$stderr_file"' EXIT

if playwright-cli "$@" 2>"$stderr_file"; then
  cat "$stderr_file" >&2
  exit 0
else
  status=$?
fi

cat "$stderr_file" >&2

# The repository config launches the system Google Chrome (channel "chrome")
# with its sandbox enabled, so it picks up Chrome's own security updates rather
# than Playwright's pinned Chromium. Installing Chrome needs root and is a
# one-time manual step, so this task does not attempt it: Playwright's own
# installer downloads an unverified package on amd64 and refuses Linux arm64.
if grep -Eq "Chromium distribution 'chrome' is not found" "$stderr_file"; then
  cat >&2 <<'MSG'

Google Chrome is not installed. Install it once yourself (it needs root):
see "Dashboard browser automation" in CLAUDE.md. Do not fall back to
Playwright's bundled Chromium.
MSG
fi

exit "$status"
