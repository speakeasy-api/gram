load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "chatsessions",
    srcs = [
        "jwt.go",
        "manager.go",
    ],
    importpath = "github.com/speakeasy-api/gram/server/internal/auth/chatsessions",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/attr",
        "//server/internal/cache",
        "//server/internal/contextvalues",
        "//server/internal/oops",
        "//server/internal/urn",
        "@com_github_go_redis_cache_v9//:cache",
