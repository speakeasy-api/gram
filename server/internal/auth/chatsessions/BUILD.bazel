go_test(
    name = "chatsessions_test",
    srcs = [
        "manager_test.go",
        "setup_test.go",
    ],
    deps = [
        ":chatsessions",
        "//server/internal/contextvalues",
        "//server/internal/oops",
        "//server/internal/testenv",
        "@com_github_google_uuid//:uuid",
        "@com_github_redis_go_redis_v9//:go-redis",
        "@com_github_stretchr_testify//require",
    ],
