load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "jwtclaims",
    srcs = ["claims.go"],
    importpath = "github.com/speakeasy-api/gram/server/internal/oauth/jwtclaims",
    visibility = ["//server:__subpackages__"],
