go_test(
    name = "directory_test",
    srcs = [
        "directory_test.go",
        "principal_test.go",
        "profile_test.go",
        "setup_test.go",
    ],
    deps = [
        ":directory",
        "//server/internal/conv",
        "//server/internal/directory/repo",
        "//server/internal/organizations/repo",
        "//server/internal/testenv",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_stretchr_testify//require",
    ],
