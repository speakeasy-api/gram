load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "launcher",
    srcs = [
        "impl.go",
        "questions.go",
    ],
    importpath = "github.com/speakeasy-api/gram/server/internal/launcher",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/gen/http/launcher/server",
        "//server/gen/launcher",
        "//server/internal/attr",
        "//server/internal/auth",
        "//server/internal/auth/sessions",
        "//server/internal/authz",
        "//server/internal/contextvalues",
        "//server/internal/conv",
        "//server/internal/middleware",
        "//server/internal/o11y",
        "//server/internal/oops",
        "//server/internal/thirdparty/openrouter",
        "//server/internal/thirdparty/typesafe",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@design_goa_goa_v3//http",
        "@design_goa_goa_v3//security",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "launcher_test",
    srcs = [
        "impl_test.go",
        "questions_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":launcher"],
    deps = [
        "//server/gen/launcher",
        "//server/internal/authz",
        "//server/internal/authztest",
        "//server/internal/contextvalues",
        "//server/internal/conv",
        "//server/internal/guardian",
        "//server/internal/oops",
        "//server/internal/testenv",
        "//server/internal/thirdparty/openrouter",
        "//server/internal/thirdparty/typesafe",
        "//server/internal/thirdparty/workos",
        "@com_github_stretchr_testify//require",
    ],
)
