load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "celeval",
    srcs = ["celeval.go"],
    importpath = "github.com/speakeasy-api/gram/server/internal/celeval",
    visibility = ["//server:__subpackages__"],
    deps = [
        "@com_github_google_cel_go//cel",
        "@com_github_google_cel_go//common/types",
        "@com_github_google_cel_go//common/types/ref",
        "@com_github_google_cel_go//interpreter",
        "@com_github_hashicorp_golang_lru_v2//:golang-lru",
        "@org_golang_x_sync//singleflight",
    ],
)

go_test(
    name = "celeval_test",
    srcs = [
        "celeval_test.go",
        "example_test.go",
    ],
    embed = [":celeval"],
    deps = [
        "@com_github_google_cel_go//cel",
        "@com_github_google_cel_go//common/types",
        "@com_github_google_cel_go//common/types/ref",
        "@com_github_google_cel_go//interpreter",
        "@com_github_stretchr_testify//require",
    ],
)
