load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "loops",
    srcs = ["client.go"],
    importpath = "github.com/speakeasy-api/gram/server/internal/thirdparty/loops",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/attr",
        "//server/internal/guardian",
        "//server/internal/o11y",
