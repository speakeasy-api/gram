go_test(
    name = "loops_test",
    srcs = ["client_test.go"],
    embed = [":loops"],
    deps = [
        "//server/internal/guardian",
        "//server/internal/testenv",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
