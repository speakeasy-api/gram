load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "svixtest",
    srcs = ["server.go"],
    importpath = "github.com/speakeasy-api/gram/server/internal/thirdparty/svix/svixtest",
    visibility = ["//server:__subpackages__"],
