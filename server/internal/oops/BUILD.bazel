load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "oops",
    srcs = [
        "clientfault.go",
        "codes.go",
        "http.go",
        "mcp.go",
        "pp.go",
        "retry.go",
    ],
    importpath = "github.com/speakeasy-api/gram/server/internal/oops",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/attr",
        "//server/internal/contextvalues",
        "//server/internal/conv",
        "//server/internal/mcp/mcpversions",
        "//server/internal/mcpjsonrpc",
        "@design_goa_goa_v3//pkg",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "oops_test",
    srcs = [
        "clientfault_test.go",
        "http_test.go",
        "mcp_test.go",
        "pp_test.go",
    ],
    embed = [":oops"],
    deps = [
        "//server/internal/contextvalues",
        "//server/internal/mcp/mcpversions",
        "//server/internal/mcpjsonrpc",
        "@com_github_stretchr_testify//require",
        "@design_goa_goa_v3//pkg",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel_sdk//trace",
        "@io_opentelemetry_go_otel_sdk//trace/tracetest",
    ],
)
