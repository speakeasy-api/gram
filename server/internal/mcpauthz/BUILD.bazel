go_test(
    name = "mcpauthz_test",
    srcs = [
        "issuer_test.go",
        "setup_test.go",
    ],
    embed = [":mcpauthz"],
    deps = [
        "//server/internal/contextvalues",
        "//server/internal/mcpidentity",
        "//server/internal/sessiontokens",
        "//server/internal/testenv",
        "//server/internal/urn",
        "//tunnel/gateway",
        "//tunnel/jwks",
        "//tunnel/route",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//require",
    ],
)
