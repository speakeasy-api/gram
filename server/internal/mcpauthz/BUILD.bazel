load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "mcpauthz",
    srcs = [
        "issuer.go",
        "sign.go",
    ],
    importpath = "github.com/speakeasy-api/gram/server/internal/mcpauthz",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/contextvalues",
        "//server/internal/mcpidentity",
        "//server/internal/urn",
        "//tunnel/jwks",
        "@com_github_golang_jwt_jwt_v5//:jwt",
        "@com_github_google_uuid//:uuid",
    ],
