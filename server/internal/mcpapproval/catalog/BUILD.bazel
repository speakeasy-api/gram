load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "catalog",
    srcs = ["catalog.go"],
    importpath = "github.com/speakeasy-api/gram/server/internal/mcpapproval/catalog",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/attr",
        "//server/internal/externalmcp",
