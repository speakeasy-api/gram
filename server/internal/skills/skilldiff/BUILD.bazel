load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "skilldiff",
    srcs = ["skilldiff.go"],
    importpath = "github.com/speakeasy-api/gram/server/internal/skills/skilldiff",
    visibility = ["//server:__subpackages__"],
    deps = [
        "@com_github_gitleaks_go_gitdiff//gitdiff",
