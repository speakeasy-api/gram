load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "bindings",
    srcs = ["bindings.go"],
    importpath = "github.com/speakeasy-api/gram/server/internal/usersessions/bindings",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/usersessions/repo",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
    ],
)

go_test(
    name = "bindings_test",
    srcs = ["bindings_test.go"],
    embed = [":bindings"],
    deps = [
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//require",
    ],
)
