go_test(
    name = "localfixture_test",
    srcs = [
        "config_test.go",
        "configurator_test.go",
        "mcp_test.go",
        "oauth_test.go",
        "publisher_test.go",
        "registry_test.go",
    ],
    embed = [":localfixture"],
    deps = [
        "//server/internal/cache",
        "//server/internal/externalmcp",
        "//server/internal/guardian",
        "//server/internal/platformmcp",
        "//server/internal/testenv",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//require",
    ],
