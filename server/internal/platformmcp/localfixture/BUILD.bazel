load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "localfixture",
    srcs = [
        "config.go",
        "configurator.go",
        "mcp.go",
        "oauth.go",
        "publisher.go",
        "registry.go",
    ],
    importpath = "github.com/speakeasy-api/gram/server/internal/platformmcp/localfixture",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/conv",
        "//server/internal/externalmcp",
        "//server/internal/guardian",
        "//server/internal/oauthwire",
        "//server/internal/platformmcp",
        "//server/internal/platformmcp/remotesessionprovider",
        "//server/internal/plugins",
        "//server/internal/remotesessions/repo",
        "//server/internal/thirdparty/github",
        "//server/internal/usersessions",
