load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "otelpub",
    srcs = [
        "context.go",
        "convert.go",
        "logger.go",
    ],
    importpath = "github.com/speakeasy-api/gram/server/internal/otelpub",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//infra/gen/gram/otel/v1:otel",
        "//infra/pkg/gcp",
        "//server/internal/contextvalues",
        "//server/internal/otel",
        "//server/internal/otel/enrich",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//semconv/v1.41.0:v1_41_0",
        "@io_opentelemetry_go_otel_log//:log",
        "@io_opentelemetry_go_otel_sdk//resource",
        "@io_opentelemetry_go_otel_trace//:trace",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "otelpub_test",
    srcs = ["logger_test.go"],
    embed = [":otelpub"],
    deps = [
        "//infra/gen/gram/otel/v1:otel",
        "//infra/pkg/gcp",
        "//server/internal/constants",
        "//server/internal/contextvalues",
        "//server/internal/otel",
        "//server/internal/otel/enrich",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//mock",
        "@com_github_stretchr_testify//require",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//semconv/v1.41.0:v1_41_0",
        "@io_opentelemetry_go_otel_log//:log",
        "@io_opentelemetry_go_otel_sdk//resource",
    ],
)
