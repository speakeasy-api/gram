<Paragraph paddingBottom="16">{data.organization_name} has used {data.usage_tokens} against an allowance of {data.token_limit}.</Paragraph>
<Section blockColor="#FFF1ED" blockBorderWidth="1" blockBorderColor="#E8A18D" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Paragraph fontSize="12" paddingBottom="4"><Strong textColor="#C83228">OVER ALLOWANCE</Strong></Paragraph>
  <H2>{data.overage_tokens}</H2>
</Section>
<Paragraph fontSize="12" lineHeight="100"><Br /></Paragraph>
<Section blockColor="#FFFFFF" blockBorderWidth="1" blockBorderColor="#DCDCDC" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Columns gap="24" widths="50,50">
    <ColumnItem>
      <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">CYCLE START</Text></Paragraph>
      <Paragraph fontSize="14" lineHeight="150">{data.cycle_start}</Paragraph>
    </ColumnItem>
    <ColumnItem>
      <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">CYCLE END</Text></Paragraph>
      <Paragraph fontSize="14" lineHeight="150">{data.cycle_end}</Paragraph>
    </ColumnItem>
  </Columns>
</Section>
<Paragraph fontSize="12" lineHeight="100" paddingTop="16"><Br /></Paragraph>
<Divider paddingBottom="16" />
<Paragraph fontSize="12"><Text textColor="#6E6E6E">This is an automated billing usage alert.</Text></Paragraph>
