<Style themeId="cmsnm620801ug0j2jdxiw79j4" backgroundColor="#FAFAFA" backgroundXPadding="0" backgroundYPadding="32" bodyColor="#FFFFFF" bodyXPadding="32" bodyYPadding="32" borderColor="#DCDCDC" borderWidth="1" borderRadius="0" buttonBodyColor="#000000" buttonBodyXPadding="20" buttonBodyYPadding="12" buttonBorderColor="" buttonBorderWidth="0" buttonBorderRadius="0" buttonTextColor="#FAFAFA" buttonTextFontSize="15" dividerColor="#DCDCDC" dividerBorderWidth="1" textBaseColor="#000000" textBaseFontSize="15" textBaseLineHeight="150" textBaseLetterSpacing="0" textLinkColor="#2873D7" heading1Color="#000000" heading1FontSize="26" heading1LineHeight="115" heading1LetterSpacing="-1" heading2Color="#000000" heading2FontSize="20" heading2LineHeight="120" heading2LetterSpacing="0" heading3Color="#000000" heading3FontSize="16" heading3LineHeight="120" heading3LetterSpacing="0" />
<Image src="https://images.vialoops.com/clydgspni01t0bsa10jmd46rt/cmt7eueee05e20izu0frdx1jq.png" alt="Speakeasy" width="160" align="left" paddingBottom="28" />
<Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">OTHER INFERENCE / CAP ALERT</Text></Paragraph>
<Section if="{data.exhausted}" ifOperation="equal" ifValue="false">
  <H1>{data.threshold_percent}% of other inference cap used</H1>
</Section>
<Section if="{data.exhausted}" ifOperation="equal" ifValue="true">
  <H1>Other inference is paused</H1>
</Section>
<Image src="https://images.vialoops.com/clydgspni01t0bsa10jmd46rt/cmshilgvx01u30j6t4t0211tl.png" alt="" width="536" paddingTop="12" paddingBottom="20" />
<Section if="{data.exhausted}" ifOperation="equal" ifValue="false">
  <Paragraph paddingBottom="16">{data.organization_name} is approaching its cap for other inference.</Paragraph>
</Section>
<Section if="{data.exhausted}" ifOperation="equal" ifValue="true">
  <Paragraph paddingBottom="16">{data.organization_name} has reached its other inference cap.</Paragraph>
</Section>
<Section blockColor="#FFF1ED" blockBorderWidth="1" blockBorderColor="#E8A18D" if="{data.exhausted}" ifOperation="equal" ifValue="true" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Paragraph fontSize="12" paddingBottom="4"><Strong textColor="#C83228">CAP REACHED</Strong></Paragraph>
  <Paragraph fontSize="14" lineHeight="150">Other inference is paused until usage resets or the cap changes.</Paragraph>
</Section>
<Section blockColor="#FFFFFF" blockBorderWidth="1" blockBorderColor="#DCDCDC" if="{data.exhausted}" ifOperation="equal" ifValue="false" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">ACTION</Text></Paragraph>
  <Paragraph fontSize="14" lineHeight="150">Review usage before the cap is exhausted.</Paragraph>
</Section>
<Paragraph fontSize="12" lineHeight="100" paddingTop="16"><Br /></Paragraph>
<Divider paddingBottom="16" />
<Paragraph fontSize="12"><Text textColor="#6E6E6E">This is an automated inference cap alert.</Text></Paragraph>
