<Style themeId="cmsnm620801ug0j2jdxiw79j4" backgroundColor="#FAFAFA" backgroundXPadding="0" backgroundYPadding="32" bodyColor="#FFFFFF" bodyXPadding="32" bodyYPadding="32" borderColor="#DCDCDC" borderWidth="1" borderRadius="0" buttonBodyColor="#000000" buttonBodyXPadding="20" buttonBodyYPadding="12" buttonBorderColor="" buttonBorderWidth="0" buttonBorderRadius="0" buttonTextColor="#FAFAFA" buttonTextFontSize="15" dividerColor="#DCDCDC" dividerBorderWidth="1" textBaseColor="#000000" textBaseFontSize="15" textBaseLineHeight="150" textBaseLetterSpacing="0" textLinkColor="#2873D7" heading1Color="#000000" heading1FontSize="26" heading1LineHeight="115" heading1LetterSpacing="-1" heading2Color="#000000" heading2FontSize="20" heading2LineHeight="120" heading2LetterSpacing="0" heading3Color="#000000" heading3FontSize="16" heading3LineHeight="120" heading3LetterSpacing="0" />
<Image src="https://images.vialoops.com/clydgspni01t0bsa10jmd46rt/cmt7eueee05e20izu0frdx1jq.png" alt="Speakeasy" width="160" align="left" paddingBottom="28" />
<Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">DIRECTORY SYNC / REVIEW</Text></Paragraph>
<H1>{data.summary}</H1>
<Image src="https://images.vialoops.com/clydgspni01t0bsa10jmd46rt/cmshilgvx01u30j6t4t0211tl.png" alt="" width="536" paddingTop="12" paddingBottom="20" />
<Section if="{data.is_reminder}" ifOperation="equal" ifValue="false">
  <Paragraph paddingBottom="16">Your directory changed in ways that may need a role in {data.organization_name}. Review each change and decide whether to map it.</Paragraph>
</Section>
<Section if="{data.is_reminder}" ifOperation="equal" ifValue="true">
  <Paragraph paddingBottom="16">These directory changes in {data.organization_name} are still waiting for a decision.</Paragraph>
</Section>
<Section blockColor="#FFFFFF" blockBorderWidth="1" blockBorderColor="#DCDCDC" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">WAITING FOR A DECISION</Text></Paragraph>
  <Paragraph fontSize="14" lineHeight="150">New groups: {data.new_group_count}<Br />New attribute values: {data.new_attribute_value_count}<Br />Mapped sources gone from the directory: {data.source_missing_count}</Paragraph>
</Section>
<Button href="{data.review_url}" align="left" paddingTop="24" paddingBottom="32">Review directory changes</Button>
<Divider paddingBottom="16" />
<Paragraph fontSize="12"><Text textColor="#6E6E6E">No roles change until an administrator decides. Mapped sources that have gone already grant nothing. You’re receiving this because you’re an administrator of {data.organization_name}.</Text></Paragraph>
