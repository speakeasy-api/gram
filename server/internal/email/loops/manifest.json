{
  "version": 1,
  "defaults": {
    "from_name": "Speakeasy",
    "from_email": "platform",
    "reply_to_email": "platform@speakeasy.com"
  },
  "templates": {
    "access_paused": {
      "managed_name": "gram.transactional.v2.access_paused",
      "subject": "Access paused for {data.organization_name}",
      "preview_text": "Start pay as you go to restore access.",
      "source": "access_paused.lmx",
      "variables": ["organization_name", "action_url"]
    },
    "access_request": {
      "managed_name": "gram.transactional.v2.access_request",
      "subject": "Access requested for {data.organization_name}",
      "preview_text": "{data.requester_name} requested additional access.",
      "source": "access_request.lmx",
      "variables": ["requester_name", "organization_name", "manage_access_link"]
    },
    "custom_domain_unhealthy": {
      "managed_name": "gram.transactional.v2.custom_domain_unhealthy",
      "subject": "Action required: {data.domain} is unhealthy",
      "preview_text": "Review the issue affecting your custom domain.",
      "source": "custom_domain_unhealthy.lmx",
      "variables": ["email", "domain", "issue_message", "domain_link"]
    },
    "enterprise_admin_onboarding": {
      "managed_name": "gram.transactional.v2.enterprise_admin_onboarding",
      "subject": "Set up your Speakeasy organization",
      "preview_text": "Your enterprise workspace is ready to configure.",
      "source": "enterprise_admin_onboarding.lmx",
      "variables": ["setup_link"]
    },
    "openrouter_chat_credits_threshold": {
      "managed_name": "gram.transactional.v2.openrouter_chat_credits_threshold",
      "subject": "Other inference cap at {data.threshold_percent}% for {data.organization_name}",
      "preview_text": "Review your other inference usage.",
      "source": "openrouter_chat_credits_threshold.lmx",
      "variables": ["organization_name", "threshold_percent", "exhausted"]
    },
    "openrouter_internal_credits_threshold": {
      "managed_name": "gram.transactional.v2.openrouter_internal_credits_threshold",
      "subject": "Security inference cap at {data.threshold_percent}% for {data.organization_name}",
      "preview_text": "Review your security inference usage.",
      "source": "openrouter_internal_credits_threshold.lmx",
      "variables": ["organization_name", "threshold_percent", "exhausted"]
    },
    "payg_activated": {
      "managed_name": "gram.transactional.v2.payg_activated",
      "subject": "Pay as you go is active for {data.organization_name}",
      "preview_text": "Review your rates and manage billing.",
      "source": "payg_activated.lmx",
      "variables": [
        "organization_name",
        "tum_price_per_million_usd",
        "action_url"
      ]
    },
    "team_invite": {
      "managed_name": "gram.transactional.v2.team_invite",
      "subject": "Join {data.organization_name} on Speakeasy",
      "preview_text": "{data.inviter_name} invited you to their Speakeasy organization.",
      "source": "team_invite.lmx",
      "variables": [
        "invite_link",
        "inviter_name",
        "inviter_email",
        "organization_name"
      ]
    },
    "trial_ending_soon": {
      "managed_name": "gram.transactional.v2.trial_ending_soon",
      "subject": "Your Speakeasy trial ends on {data.trial_end_date}",
      "preview_text": "Set up billing to keep access for {data.organization_name}.",
      "source": "trial_ending_soon.lmx",
      "variables": ["organization_name", "trial_end_date", "action_url"]
    },
    "weekly_usage_summary": {
      "managed_name": "gram.transactional.v2.weekly_usage_summary",
      "subject": "Weekly usage for {data.organization_name}",
      "preview_text": "Usage through {data.usage_through_date} across storage, scanning, and egress.",
      "source": "weekly_usage_summary.lmx",
      "variables": [
        "organization_name",
        "cycle_end_date",
        "days_remaining",
        "usage_through_date",
        "storage_tokens",
        "storage_change_percent",
        "scanning_tokens",
        "scanning_change_percent",
        "egress_gib",
        "egress_change_percent",
        "show_estimated_spend",
        "storage_cost_usd",
        "scanning_cost_usd",
        "egress_cost_usd",
        "total_cost_usd",
        "view_usage_url"
      ]
    }
  }
}
