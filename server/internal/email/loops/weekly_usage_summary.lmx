<Style themeId="cmsnm620801ug0j2jdxiw79j4" backgroundColor="#FAFAFA" backgroundXPadding="0" backgroundYPadding="32" bodyColor="#FFFFFF" bodyXPadding="32" bodyYPadding="32" borderColor="#DCDCDC" borderWidth="1" borderRadius="0" buttonBodyColor="#000000" buttonBodyXPadding="20" buttonBodyYPadding="12" buttonBorderColor="" buttonBorderWidth="0" buttonBorderRadius="0" buttonTextColor="#FAFAFA" buttonTextFontSize="15" dividerColor="#DCDCDC" dividerBorderWidth="1" textBaseColor="#000000" textBaseFontSize="15" textBaseLineHeight="150" textBaseLetterSpacing="0" textLinkColor="#2873D7" heading1Color="#000000" heading1FontSize="26" heading1LineHeight="115" heading1LetterSpacing="-1" heading2Color="#000000" heading2FontSize="20" heading2LineHeight="120" heading2LetterSpacing="0" heading3Color="#000000" heading3FontSize="16" heading3LineHeight="120" heading3LetterSpacing="0" />
<Image src="https://images.vialoops.com/clydgspni01t0bsa10jmd46rt/cmt7eueee05e20izu0frdx1jq.png" alt="Speakeasy" width="160" align="left" paddingBottom="28" />
<Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">WEEKLY USAGE / {data.organization_name}</Text></Paragraph>
<H1>Your usage at a glance</H1>
<Image src="https://images.vialoops.com/clydgspni01t0bsa10jmd46rt/cmshilgvx01u30j6t4t0211tl.png" alt="" width="536" paddingTop="12" paddingBottom="20" />
<Section blockColor="#FFFFFF" blockBorderWidth="1" blockBorderColor="#DCDCDC" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Columns gap="24" widths="50,50">
    <ColumnItem>
      <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">USAGE THROUGH</Text></Paragraph>
      <Paragraph fontSize="14" lineHeight="150">{data.usage_through_date}</Paragraph>
    </ColumnItem>
    <ColumnItem>
      <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">CYCLE ENDS</Text></Paragraph>
      <Paragraph fontSize="14" lineHeight="150">{data.cycle_end_date}</Paragraph>
      <Paragraph fontSize="12" paddingTop="4"><Text textColor="#6E6E6E">{data.days_remaining} remaining</Text></Paragraph>
    </ColumnItem>
  </Columns>
</Section>
<Paragraph fontSize="12" lineHeight="100"><Br /></Paragraph>
<Section blockColor="#FFFFFF" blockBorderWidth="1" blockBorderColor="#DCDCDC" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">AGENT SESSION STORAGE / CYCLE TO DATE</Text></Paragraph>
  <H2 fontSize="28">{data.storage_tokens} tokens</H2>
  <Paragraph fontSize="12" paddingTop="6"><Text textColor="#6E6E6E">{data.storage_change_percent} vs. the same point last cycle</Text></Paragraph>
</Section>
<Paragraph fontSize="12" lineHeight="100"><Br /></Paragraph>
<Section blockColor="#FFFFFF" blockBorderWidth="1" blockBorderColor="#DCDCDC" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">RISK SCANNING / CYCLE TO DATE</Text></Paragraph>
  <H2 fontSize="28">{data.scanning_tokens} tokens</H2>
  <Paragraph fontSize="12" paddingTop="6"><Text textColor="#6E6E6E">{data.scanning_change_percent} vs. the same point last cycle</Text></Paragraph>
</Section>
<Paragraph fontSize="12" lineHeight="100"><Br /></Paragraph>
<Section blockColor="#FFFFFF" blockBorderWidth="1" blockBorderColor="#DCDCDC" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">MCP GATEWAY / CYCLE TO DATE</Text></Paragraph>
  <H2 fontSize="28">{data.egress_gib} GiB egress</H2>
  <Paragraph fontSize="12" paddingTop="6"><Text textColor="#6E6E6E">{data.egress_change_percent} vs. the same point last cycle</Text></Paragraph>
</Section>
<Paragraph fontSize="12" lineHeight="100"><Br /></Paragraph>
<Section blockColor="#FAFAFA" blockBorderWidth="1" blockBorderColor="#DCDCDC" if="{data.show_estimated_spend}" ifOperation="equal" ifValue="true" paddingTop="18" paddingRight="20" paddingBottom="16" paddingLeft="20">
  <Paragraph fontSize="12" paddingBottom="12"><Text textColor="#6E6E6E">ESTIMATED PAYG SPEND</Text></Paragraph>
  <Columns gap="24" widths="50,50">
    <ColumnItem>
      <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">AGENT SESSION STORAGE</Text></Paragraph>
      <Paragraph fontSize="16" lineHeight="150"><Strong>{data.storage_cost_usd}</Strong></Paragraph>
    </ColumnItem>
    <ColumnItem>
      <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">RISK SCANNING</Text></Paragraph>
      <Paragraph fontSize="16" lineHeight="150"><Strong>{data.scanning_cost_usd}</Strong></Paragraph>
    </ColumnItem>
  </Columns>
  <Paragraph fontSize="12" lineHeight="100"><Br /></Paragraph>
  <Columns gap="24" widths="50,50">
    <ColumnItem>
      <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">MCP GATEWAY</Text></Paragraph>
      <Paragraph fontSize="16" lineHeight="150"><Strong>{data.egress_cost_usd}</Strong></Paragraph>
    </ColumnItem>
    <ColumnItem>
      <Paragraph fontSize="12" paddingBottom="4"><Text textColor="#6E6E6E">TOTAL</Text></Paragraph>
      <Paragraph fontSize="20" lineHeight="150"><Strong>{data.total_cost_usd}</Strong></Paragraph>
    </ColumnItem>
  </Columns>
  <Paragraph fontSize="12" paddingTop="12"><Text textColor="#6E6E6E">Estimated using current Speakeasy pay-as-you-go list prices. Final billed amounts may vary.</Text></Paragraph>
</Section>
<Button href="{data.view_usage_url}" align="left" paddingTop="24" paddingBottom="32">View detailed usage</Button>
<Divider paddingBottom="16" />
<Paragraph fontSize="12"><Text textColor="#6E6E6E">You’re receiving this operational report because you’re a billing contact or organization admin in Speakeasy.</Text></Paragraph>
