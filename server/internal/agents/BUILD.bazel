    srcs = [
        "lifecycle_test.go",
        "persistence_test.go",
        "resolve_test.go",
        "setup_test.go",
    ],
    embed = [":agents"],
    deps = [
        "//server/internal/agents/repo",
        "//server/internal/conv",
        "//server/internal/organizations/repo",
        "//server/internal/testenv",
        "//server/internal/testenv/testrepo",
        "//server/internal/urn",
        "//server/internal/users/repo",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgtype",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_stretchr_testify//require",
    ],
