load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "agents",
    srcs = [
        "lifecycle.go",
        "resolve.go",
    ],
    importpath = "github.com/speakeasy-api/gram/server/internal/agents",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/agents/lifecycle",
        "//server/internal/agents/repo",
        "//server/internal/urn",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
