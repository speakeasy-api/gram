{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gram registry metadata extensions",
  "type": "object",
  "properties": {
    "_meta": {
      "type": "object",
      "properties": {
        "com.speakeasy.ai/registry": {
          "type": "object",
          "description": "Backend-owned first recorded publication. Historical publication dates may be unknown.",
          "readOnly": true,
          "properties": {
            "publishedAt": {
              "type": "string",
              "format": "date-time",
              "readOnly": true
            }
          },
          "additionalProperties": false
        },
        "com.speakeasy.ai/catalog": {
          "type": "object",
          "description": "Staff-maintained catalog metadata, visible to all authenticated registry consumers. Never include secrets.",
          "properties": {
            "documentationUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^/?#\\s]+",
              "description": "Public documentation URL."
            }
          }
        }
      }
    }
  }
}
