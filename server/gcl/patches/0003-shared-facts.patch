diff --git b/pkg/goanalysis/runner_facts.go b/pkg/goanalysis/runner_facts.go
new file mode 100644
index 0000000..faf9455
--- /dev/null
+++ b/pkg/goanalysis/runner_facts.go
@@ -0,0 +1,141 @@
+package goanalysis
+
+import (
+	"go/types"
+
+	"golang.org/x/tools/go/analysis"
+	"golang.org/x/tools/go/packages"
+)
+
+// Facts of dependencies.
+//
+// Instead of copying the facts of every transitive dependency into each action
+// (which is quadratic in the size of the import graph, in both time and memory),
+// each action only keeps the facts about its own package,
+// and facts about other packages are read from the action that produced them.
+//
+// The runner keeps an index from a package's final *types.Package to the
+// fact-producing actions of that package. The entry is stored once the package
+// is loaded (for packages loaded from export data and then reloaded from source,
+// after the reload, so the key is the *types.Package dependents see), before any
+// of its actions run. Dependents only read it after the package's analyzeRecursive
+// has returned, i.e. after all its actions are done. The entry is deleted, and the
+// producers' maps are freed, by decUse once the package and all its transitive
+// dependents are done, so the index never outlives its readers.
+
+// registerFactProducers publishes the fact-producing actions of lp.
+func (lp *loadingPackage) registerFactProducers() {
+	pkg := lp.pkg
+	if pkg.Types == nil {
+		return
+	}
+
+	var producers []*action
+	for _, act := range lp.actions {
+		if len(act.Analyzer.FactTypes) > 0 {
+			producers = append(producers, act)
+		}
+	}
+	if len(producers) == 0 {
+		return
+	}
+
+	directDeps := make(map[*types.Package]struct{}, len(pkg.Imports))
+	for _, imp := range pkg.Imports {
+		if imp.Types != nil {
+			directDeps[imp.Types] = struct{}{}
+		}
+	}
+	for _, act := range producers {
+		act.directDeps = directDeps
+	}
+
+	lp.factProducers.Store(pkg.Types, producers)
+}
+
+// unregisterFactProducers is called by decUse when no dependent can read lp's facts anymore.
+func (lp *loadingPackage) unregisterFactProducers() {
+	if lp.pkg.Types != nil {
+		lp.factProducers.Delete(lp.pkg.Types)
+	}
+}
+
+// factProducer returns the action of the same analyzer for pkg, if any.
+func (act *action) factProducer(pkg *types.Package) *action {
+	v, ok := act.runner.factProducers.Load(pkg)
+	if !ok {
+		return nil
+	}
+	for _, prod := range v.([]*action) {
+		if prod.Analyzer == act.Analyzer {
+			return prod
+		}
+	}
+	return nil
+}
+
+// objectFactVisible reports whether a fact about obj, which belongs to the dependency pkg,
+// is visible to act, using the same filter as when facts were copied along every import edge:
+// a fact crossed an edge only if exportedFrom(obj, dep) held, dep being the imported package.
+// At the first edge dep is obj's own package. At any further edge dep is a package obj does
+// not belong to, and then exportedFrom only depends on obj (methods, fields, type names and
+// constants pass), so the result is the same for every import path.
+func (act *action) objectFactVisible(obj types.Object, pkg *types.Package) bool {
+	if !exportedFrom(obj, pkg) {
+		return false
+	}
+	if _, direct := act.directDeps[pkg]; direct {
+		return true
+	}
+	return exportedFrom(obj, nil) // obj.Pkg() != nil, so this is the "not obj's package" case.
+}
+
+// objectFactsFor returns the map that holds the facts about obj visible to act, or nil.
+func (act *action) objectFactsFor(obj types.Object) map[objectFactKey]analysis.Fact {
+	pkg := obj.Pkg()
+	if pkg == act.Package.Types {
+		return act.objectFacts
+	}
+	if pkg == nil || !act.objectFactVisible(obj, pkg) {
+		return nil
+	}
+	if prod := act.factProducer(pkg); prod != nil {
+		return prod.objectFacts
+	}
+	return nil
+}
+
+// packageFactsFor returns the map that holds the facts about pkg, or nil.
+func (act *action) packageFactsFor(pkg *types.Package) map[packageFactKey]analysis.Fact {
+	if pkg == act.Package.Types {
+		return act.packageFacts
+	}
+	if prod := act.factProducer(pkg); prod != nil {
+		return prod.packageFacts
+	}
+	return nil
+}
+
+// forEachDepProducer calls fn for the producer of every transitive dependency of act's package.
+// It walks packages.Package.Imports, which (unlike action.Deps) decUse never clears.
+func (act *action) forEachDepProducer(fn func(pkg *types.Package, prod *action)) {
+	seen := map[*packages.Package]bool{act.Package: true}
+	stack := []*packages.Package{act.Package}
+	for len(stack) > 0 {
+		p := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		for _, imp := range p.Imports {
+			if seen[imp] {
+				continue
+			}
+			seen[imp] = true
+			stack = append(stack, imp)
+			if imp.Types == nil {
+				continue
+			}
+			if prod := act.factProducer(imp.Types); prod != nil {
+				fn(imp.Types, prod)
+			}
+		}
+	}
+}
