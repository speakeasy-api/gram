    srcs = [
        "directory.go",
        "evidence.go",
        "handler.go",
        "workos.go",
        "workos_types.go",
    ],
    importpath = "github.com/speakeasy-api/gram/dev-idp/internal/modes/mockworkos",
    visibility = ["//dev-idp:__subpackages__"],
    deps = [
