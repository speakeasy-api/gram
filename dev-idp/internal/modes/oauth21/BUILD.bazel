load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "oauth21",
    srcs = [
        "handler.go",
        "idjag.go",
    ],
    importpath = "github.com/speakeasy-api/gram/dev-idp/internal/modes/oauth21",
    visibility = ["//dev-idp:__subpackages__"],
    deps = [
        "//dev-idp/internal/cimd",
        "//dev-idp/internal/database/repo",
        "//dev-idp/internal/defaultuser",
        "//dev-idp/internal/ema",
        "//dev-idp/internal/jwks",
        "//dev-idp/internal/keystore",
        "@com_github_golang_jwt_jwt_v5//:jwt",
        "@com_github_google_uuid//:uuid",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
