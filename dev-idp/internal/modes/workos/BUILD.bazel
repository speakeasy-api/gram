load("@rules_go//go:def.bzl", "go_library")
load("//tools/bazel:go_test.bzl", "go_test")

go_library(
    name = "workos",
    srcs = [
        "backend.go",
        "handler.go",
    ],
    importpath = "github.com/speakeasy-api/gram/dev-idp/internal/modes/workos",
    visibility = ["//dev-idp:__subpackages__"],
    deps = [
        "//dev-idp/internal/database/repo",
        "//dev-idp/internal/defaultuser",
        "//dev-idp/internal/workos",
        "@com_github_google_uuid//:uuid",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "workos_test",
    srcs = ["handler_test.go"],
    embed = [":workos"],
    deps = [
        "//dev-idp/internal/bootstrap",
        "//dev-idp/internal/config",
        "//dev-idp/internal/database/repo",
        "//plog",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//require",
        "@io_opentelemetry_go_otel_trace//noop",
    ],
)
