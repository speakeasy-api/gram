{
  "name": "@gram/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test:registry-editor": "playwright test --config registry-editor.config.ts",
    "test:ui-fuzz": "playwright test --config ui-fuzz.config.ts ui-fuzz.spec.ts",
    "test:ui-fuzz:unit": "node --test ui-fuzz/*.test.ts",
    "test:ui-fuzz:record": "playwright test --config ui-fuzz.config.ts ui-fuzz-record.spec.ts",
    "test:ui-fuzz:summary": "node ui-fuzz/summarize.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.13.3"
  }
}
