#!/usr/bin/env bash
# Inside the agent jail: drive a browser against the local stack. `open`
# always uses the jail's headless config. Commands that read or save the
# login are refused: their output would land in the uploaded transcript.
set -euo pipefail
cd "${JAIL_WORK:?}"
command=""
for arg in "$@"; do
    case "$arg" in -*) ;; *)
        command="$arg"
        break
        ;;
    esac
done
case "$command" in
    state-* | cookie-* | localstorage-* | sessionstorage-* | request | request-headers | \
        response-headers | tracing-* | video-* | attach | install | install-browser)
        echo "flow-browser: \"$command\" is not allowed here" >&2
        exit 2
        ;;
esac
for arg in "$@"; do
    case "$arg" in -s=* | --session* | --config* | --profile* | --persistent | --browser*)
        echo "flow-browser: option $arg is not allowed" >&2
        exit 2
        ;;
    esac
done
if [ "$command" = open ]; then
    exec playwright-cli -s=heal open --config="$JAIL_WORK/cli.config.json" "${@:2}"
fi
exec playwright-cli -s=heal "$@"
